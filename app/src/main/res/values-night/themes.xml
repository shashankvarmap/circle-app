<resources>
    <style name="Theme.Circle" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/circle_background</item>
        <item name="android:statusBarColor">@color/circle_background</item>
        <item name="android:navigationBarColor">@color/circle_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Shown by the system splash only while the session is read; then Theme.Circle. -->
    <style name="Theme.Circle.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/circle_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Circle</item>
    </style>
</resources>
