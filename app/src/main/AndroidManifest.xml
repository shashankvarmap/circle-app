<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Only to show the "You're offline" banner. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Asked only when you tap Connect contacts (with the rationale on screen first). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Save a copy: a progress notification while the ZIP is prepared (shown only if notifications are allowed). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".CircleApplication"
        android:allowBackup="false"
        android:label="Circle"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Circle"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Circle.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- In-app deep links (notifications, shared links); they go through the same repository checks. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="circle" android:host="app" />
            </intent-filter>
            <!-- Invite links (Android App Link). Placeholder domain until the real one is chosen;
                 the site must serve /.well-known/assetlinks.json (template in design-handoff/assetlinks.json). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="circle.app" android:pathPrefix="/i/" />
            </intent-filter>
        </activity>
        <!-- WorkManager's foreground service for Save a copy (Android 14 needs the type). -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>
</manifest>
